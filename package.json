  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "glob": "^14.0.6",
    "typescript": "~5.6.2",
    "vite": "^6.4.6",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.25.12": true
